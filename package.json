{
  "name": "booking-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A personal phone agent built on AgentPhone: ask by MCP, text, or voice; it calls on your behalf and texts you the result.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "mcp": "npm run -s start -w @callagent/mcp",
    "cli": "npm run -s start -w @callagent/cli --",
    "phone": "npm run -s start -w @callagent/phone",
    "db:up": "docker compose up -d --wait postgres",
    "db:migrate": "npm run -s migrate -w @callagent/db",
    "db:generate": "npm run -s generate -w @callagent/db",
    "db:studio": "npm run -s studio -w @callagent/db",
    "postinstall": "npm run -s generate -w @callagent/db",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
