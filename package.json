{
  "name": "booking-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A personal phone agent built on AgentPhone: ask from Claude (MCP), by text, or by phone call; it calls on your behalf and texts you the result.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "mcp": "npm run -s start -w @callagent/mcp",
    "server": "npm run -s start -w @callagent/server",
    "db:up": "docker compose up -d --wait postgres",
    "db:migrate": "npm run -s migrate -w @callagent/core",
    "db:deploy": "npm run -s deploy -w @callagent/core",
    "db:generate": "npm run -s generate -w @callagent/core",
    "db:studio": "npm run -s studio -w @callagent/core",
    "postinstall": "npm run -s generate -w @callagent/core",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
