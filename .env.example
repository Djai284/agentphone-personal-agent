# `npm run setup` creates .env from this file and asks for the required values.

# ── Required ────────────────────────────────────────────────────────────────
# AgentPhone dashboard → API keys
AGENTPHONE_API_KEY=
# console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# Your mobile number. Results of calls you start from MCP or the CLI are texted here.
USER_PHONE=

# ── Filled in by `npm run setup` ────────────────────────────────────────────
AGENTPHONE_AGENT_ID=
AGENTPHONE_NUMBER_ID=

# ── Optional ────────────────────────────────────────────────────────────────
# Postgres. Defaults to the Docker one from `npm run db:up`
# (postgresql://callagent:callagent@localhost:5434/callagent).
# DATABASE_URL=
# Used by `npm test` (created automatically by the Docker Postgres).
TEST_DATABASE_URL=postgresql://callagent:callagent@localhost:5434/callagent_test
# Your name, used by default when you text the agent from USER_PHONE.
# USER_NAME=
# Comma-separated numbers the agent may call. Empty = any number.
# CALL_ALLOWLIST=
# Claude model for intake, preflight, and grading calls.
# ANTHROPIC_MODEL=claude-opus-5-5
# AgentPhone voice and model tier for calls.
# AGENTPHONE_VOICE=cartesia-Cleo
# AGENTPHONE_MODEL_TIER=balanced
# Port for `npm run server`.
# PORT=8787
