# AgentPhone (dashboard → API keys)
AGENTPHONE_API_KEY=
# The hosted "Personal Call Agent" and the number it calls/texts from (see docs/agentphone-setup.md)
AGENTPHONE_AGENT_ID=
AGENTPHONE_NUMBER_ID=
# Anthropic, for preflight checks and outcome extraction
ANTHROPIC_API_KEY=
# Your phone: default destination for result texts (E.164)
USER_PHONE=+1XXXXXXXXXX
# Optional: comma-separated E.164 numbers the agent may call (empty = any US/CA number)
CALL_ALLOWLIST=

# Postgres (`npm run db:up` starts it in Docker)
DATABASE_URL=postgresql://callagent:callagent@localhost:5434/callagent
TEST_DATABASE_URL=postgresql://callagent:callagent@localhost:5434/callagent_test
